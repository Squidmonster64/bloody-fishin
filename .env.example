# ─── Bloody Dave's Fishing Planner — Environment Variables ───────────────────
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Railway: set these via the Railway dashboard → Variables tab.
# All variables prefixed with VITE_ are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on.
# Railway injects PORT automatically — do not set this manually on Railway.
PORT=3000

# Node environment. Set to "production" on Railway.
NODE_ENV=production

# Public deployment label returned by /health and /readyz (for example staging).
APP_STAGE=local

# Optional server-side commercial Open-Meteo configuration. Leave blank for
# the current non-commercial free endpoints. These values are never exposed to
# the browser or native bundle. Use the exact customer endpoints supplied by
# Open-Meteo with an approved subscription.
OPEN_METEO_WEATHER_URL=
OPEN_METEO_MARINE_URL=
OPEN_METEO_GEOCODING_URL=
OPEN_METEO_API_KEY=

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Umami analytics endpoint and website ID.
# Leave blank to disable analytics.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ── App metadata (optional) ───────────────────────────────────────────────────
VITE_APP_ID=
VITE_APP_TITLE=Bloody Dave's Fishing Planner
VITE_APP_LOGO=

# Optional compile-time API origin. Ordinary web builds leave this blank and
# use their own origin. The repository-owned Capacitor build defaults to the
# separate staging backend at https://boating.bloodydaves.com.
VITE_API_ORIGIN=

# The free Open-Meteo endpoints need no key for qualifying non-commercial use.
# Commercial use requires the approved customer endpoint, key and licence.
